# Copy to .env and fill in.
ADMIN_EMAIL=patrickphandera@gmail.com
# Long random string; keeps admin sessions valid across restarts.
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:3000
DEFAULT_LANGUAGE=ny

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
# If left empty, the login code is printed in the Flask console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
